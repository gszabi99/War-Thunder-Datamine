{
  "tdiv": {
    "height": "fh",
    "id": "decor_menu",
    "frame": {
      "size": "@countDecalsInWidth * @customizationDecoratorBlockWidth + @scrollBarSize + @buttonMargin, ph",
      "tdiv": {
        "height": "@frameHeaderHeight",
        "width": "pw",
        "frame_header": {
          "activeText": {
            "id": "decals_wnd_header",
            "text": "#decals",
            "caption": "yes"
          },
          "Button_close": {
            "style": "_on_click:onBtnCloseDecalsMenu"
          }
        }
      },
      "EditBox": {
        "id": "filter_edit_box",
        "width": "pw",
        "on_change_value": "onSearchFieldChange",
        "on_cancel_edit": "onFilterCancel",
        "text": "",
        "edit-hint": "#contacts/search_placeholder"
      },
      "CheckBox": {
        "id": "filter_only_avalible",
        "btnName": "LB",
        "text": "#mainmenu/itemReceived",
        "value": "no",
        "on_change_value": "filterOnlyRecieved",
        "CheckBoxImg": {},
        "ButtonImg": {}
      },
      "decorPanels": {
        "id": "panels",
        "size": "pw, fh",
        "currentPanel": "categories",
        "css-hier-invalidate": "yes",
        "categoriesPanel": {
          "id": "categories_list",
          "width": "pw",
          "margin": "@buttonMargin",
          "behaviour": "posNavigator",
          "moveX": "linear",
          "moveY": "linear",
          "navigatorShortcuts": "yes",
          "move-only-hover": "yes",
          "on_select": "onDecorCategorySelect",
          "on_activate": "onDecorCategoryActivate",
          "css-hier-invalidate": "yes",
          "flow": "vertical",
          "class": "decalsList",
          "overflow-y": "auto",
          "canSelectNone": "yes",
          "position": "absolute"
        },
        "searchResultPanel": {
          "id": "search_result",
          "behaviour": "flow",
          "width": "pw",
          "margin": "@buttonMargin",
          "css-hier-invalidate": "yes",
          "overflow-y": "auto",
          "position": "absolute",
          "display": "hide"
        }
      }
    }
  }
}