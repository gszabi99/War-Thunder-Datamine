{
  "listbox": {
    "id": "items_list",
    "size": "pw, fh",
    "navigatorShortcuts": "yes",
    "overflow-y": "auto",
    "on_scroll_change": "onScrollMissionsList",
    "move-only-hover": "yes",
    "css-hier-invalidate": "yes",
    "always-send-select": "yes",
    "on_select": "onItemSelect",
    "on_wrap_up": "onListWrapUp",
    "on_wrap_down": "onListWrapDown",
    "_on_dbl_click": "onItemDblClick"
  }
}