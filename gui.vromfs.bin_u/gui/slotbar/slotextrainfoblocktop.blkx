{
  "extraInfoBlockTop": {
    "id": "extraInfoBlockTop",
    "hasInfo": "no",
    "cursor": "normal",
    "tdiv": {
      "size": "pw, ph",
      "textareaNoTab": [
        {
          "id": "extraInfoPriceText",
          "width": "0",
          "smallFont": "yes",
          "text": "",
          "text-align": "center",
          "position": "relative",
          "pos": "0, ph/2-(h-@sf/@pf)/2",
          "display": "hide",
          "hasInfo": "no"
        },
        {
          "id": "additionalRespawns",
          "width": "0",
          "smallFont": "yes",
          "text": "",
          "text-align": "center",
          "position": "relative",
          "pos": "0, ph/2-(h-@sf/@pf)/2",
          "display": "hide",
          "hasInfo": "no"
        },
        {
          "id": "spareCount",
          "width": "fw",
          "smallFont": "yes",
          "text": "",
          "text-align": "center",
          "position": "relative",
          "pos": "0, ph/2-(h-@sf/@pf)/2",
          "display": "hide",
          "hasInfo": "no"
        }
      ],
      "extraInfoVertSeparator": [
        {
          "id": "priceSeparator",
          "display": "hide"
        },
        {
          "id": "additionalRespawnsSeparator",
          "display": "hide"
        },
        {
          "id": "spareSeparator",
          "display": "hide"
        },
        {
          "id": "diceSeparator",
          "display": "hide"
        }
      ],
      "tdiv": [
        {
          "id": "additionalHistoricalRespawnsNest",
          "width": "0",
          "position": "relative",
          "pos": "0, ph/2-(h-@sf/@pf)/2",
          "css-hier-invalidate": "yes",
          "display": "hide",
          "hasInfo": "no",
          "tdiv": {
            "position": "relative",
            "pos": "pw/2-w/2, ph/2-h/2",
            "css-hier-invalidate": "yes",
            "tdiv": {
              "id": "unitClassIco",
              "size": "@cIco, @sIco",
              "pos": "0, ph/2-h/2",
              "position": "relative",
              "background-svg-size": "@cIco, @sIco",
              "background-repeat": "aspect-ratio",
              "background-image": "",
              "background-color": "",
              "margin-right": "2@sf/@pf"
            },
            "textareaNoTab": {
              "id": "additionalHistoricalRespawns",
              "smallFont": "yes",
              "text": "",
              "text-align": "center",
              "position": "relative",
              "pos": "0, ph/2-h/2"
            }
          }
        },
        {
          "id": "dice",
          "width": "fw",
          "height": "ph",
          "position": "relative",
          "padding": "3@sf/@pf",
          "display": "hide",
          "hasInfo": "no",
          "img": {
            "size": "ph, ph",
            "halign": "center",
            "position": "relative",
            "background-svg-size": "ph, ph",
            "background-repeat": "aspect-ratio",
            "background-image": "#ui/gameuiskin#dice_outline_white.svg"
          }
        }
      ],
      "text": {
        "id": "emptyExtraInfoText",
        "width": "fw",
        "position": "relative",
        "pos": "0, ph/2-(h-@sf/@pf)/2",
        "text": "#ui/minus",
        "overlayTextColor": "common",
        "display": "hide"
      }
    },
    "slotMissionHintContainer": {
      "id": "slotMissionHintContainer",
      "hasInfo": "no",
      "slotMissionHint": {
        "id": "slotMissionHint",
        "textareaNoTab": [
          {
            "id": "extraInfoPriceTextHint",
            "width": "pw",
            "smallFont": "yes",
            "text": "",
            "position": "relative",
            "margin-bottom": "3@sf/@pf",
            "display": "hide"
          },
          {
            "id": "additionalRespawnsHintText",
            "margin-bottom": "3@sf/@pf",
            "width": "pw",
            "smallFont": "yes",
            "text": "",
            "position": "relative",
            "display": "hide"
          },
          {
            "id": "spareHintText",
            "margin-bottom": "3@sf/@pf",
            "display": "hide",
            "width": "pw",
            "smallFont": "yes",
            "text": "",
            "position": "relative"
          },
          {
            "id": "randomUnitsListText",
            "margin-bottom": "3@sf/@pf",
            "width": "pw",
            "smallFont": "yes",
            "text": "#respawn/randomUnitsList",
            "position": "relative"
          }
        ],
        "tdiv": [
          {
            "id": "additionalHistoricalRespawnsHint",
            "width": "pw",
            "position": "relative",
            "margin-bottom": "3@sf/@pf",
            "display": "hide",
            "tdiv": {
              "position": "relative",
              "pos": "0, ph/2-h/2",
              "width": "pw",
              "tdiv": {
                "id": "unitClassIco",
                "size": "@cIco, @sIco",
                "position": "relative",
                "background-svg-size": "@cIco, @sIco",
                "background-repeat": "aspect-ratio",
                "background-image": "",
                "background-color": "@commonTextColor",
                "margin-right": "2@sf/@pf"
              },
              "textareaNoTab": {
                "id": "hintText",
                "width": "pw",
                "smallFont": "yes",
                "text": "",
                "position": "relative",
                "pos": "-@cIco, ph/2-h/2",
                "paragraph-indent": "7@blockInterval"
              }
            }
          },
          {
            "id": "hasDice",
            "margin-bottom": "1@blockInterval",
            "width": "pw",
            "tdiv": {
              "size": "@weaponStatusIconSize, @weaponStatusIconSize",
              "margin-right": "1@blockInterval",
              "background-svg-size": "@weaponStatusIconSize, @weaponStatusIconSize",
              "background-repeat": "aspect-ratio",
              "background-image": "#ui/gameuiskin#dice_outline_white.svg",
              "bgcolor": "@commonTextColor",
              "margin-top": "3@sf/@pf"
            },
            "textareaNoTab": {
              "width": "fw",
              "smallFont": "yes",
              "text": "#respawn/randomUnitHint",
              "position": "relative"
            }
          },
          {
            "id": "randomUnitsList",
            "flow": "vertical"
          }
        ]
      },
      "slotHoverHighlight": {},
      "slotBottomGradientLine": {}
    }
  }
}