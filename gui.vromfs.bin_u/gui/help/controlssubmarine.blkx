        },
        {
          "id": "ship_target_point",
          "pos": "140/1760pw, 635/900ph",
          "position": "absolute",
          "size": "1@dp, 1@dp"
        },
        {
          "pos": "304/1760pw, 700/900ph",
          "position": "absolute",
          "flow": "vertical",
          "tdiv": [
            {
              "id": "distance_point",
              "textareaNoTab": [
                {
                  "fcsHud": "yes",
