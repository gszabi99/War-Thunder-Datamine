{
  "tdiv": {
    "id": "help_background_image",
    "size": "pw, ph",
    "max-height": "pw/1760*900",
    "background-repeat": "expand",
    "background-color": "@white",
    "tdiv": {
      "size": "pw, ph",
      "pos": "0.5pw-0.5w, 0.5ph-0.5h",
      "position": "relative",
      "tdiv": [
        {
          "pos": "16/1760pw, 16/900ph",
          "position": "absolute",
          "width": "250/1760pw",
          "flow": "vertical",
          "controlsHelpFrame": [
            {
              "width": "pw",
              "keyDiv": [
                {
                  "value": "{{submarine_main_engine=max}}"
                },
                {
                  "value": "{{submarine_main_engine=min}}"
                }
              ],
              "textareaNoTab": {
                "text": "#controls/submarine_main_engine"
              }
            },
            {
              "width": "pw",
              "keyDiv": [
                {
                  "value": "{{submarine_steering=min}}"
                },
                {
                  "value": "{{submarine_steering=max}}"
                }
              ],
              "textareaNoTab": {
                "text": "#controls/submarine_steering"
              }
            },
            {
              "width": "pw",
              "keyDiv": [
                {
                  "value": "{{submarine_depth=max}}"
                },
                {
                  "value": "{{submarine_depth=min}}"
                }
              ],
              "textareaNoTab": {
                "text": "#controls/submarine_depth"
              }
            },
            {
              "width": "pw",
              "keyDiv": {
                "value": "{{ID_SUBMARINE_FULL_STOP}}"
              },
              "textareaNoTab": {
                "text": "#hotkeys/ID_SUBMARINE_FULL_STOP"
              }
            }
          ]
        },
        {
          "pos": "563/1760pw-w, 16/900ph",
          "position": "absolute",
          "width": "255/1760pw",
          "flow": "vertical",
          "controlsHelpFrame": [
            {
              "width": "pw",
              "keyDiv": {
                "value": "{{ID_SUBMARINE_WEAPON_TORPEDOES}}"
              },
              "textareaNoTab": {
                "text": "#hotkeys/ID_SUBMARINE_WEAPON_TORPEDOES"
              }
            },
            {
              "width": "pw",
              "keyDiv": {
                "value": "{{ID_SUBMARINE_TORPEDO_COURSE_TOGGLE}}"
              },
              "textareaNoTab": {
                "text": "#hotkeys/ID_SUBMARINE_TORPEDO_COURSE_TOGGLE"
              }
            },
            {
              "width": "pw",
              "keyDiv": {
                "value": "{{ID_SHIP_WEAPON_MINE}}"
              },
              "textareaNoTab": {
                "text": "#hotkeys/ID_SHIP_WEAPON_MINE"
              }
            }
          ]
        },
        {
          "id": "depth_indicator_label",
          "pos": "1196/1760pw, 16/900ph",
          "position": "absolute",
          "width": "225/1760pw",
          "flow": "vertical",
          "controlsHelpTextArea": {
            "width": "pw",
            "padding-left": "5*@sf/@pf_outdated+4@sf/@pf+1@blockInterval",
            "text": "#controls/help/submarine/depth_indicator"
          },
          "controlsHelpFrame": [
            {
              "width": "pw",
              "padding-left": "5*@sf/@pf_outdated+4@sf/@pf+1@blockInterval",
              "flow": "vertical",
              "tdiv": {
                "size": "4@sf/@pf, ph-4*@sf/@pf_outdated",
                "pos": "5*@sf/@pf_outdated, 2*@sf/@pf_outdated",
                "position": "absolute",
                "background-color": "#dddddd"
              },
              "textareaNoTab": {
                "text": "#controls/help/submarine/depth_indicator_normal"
              }
            },
            {
              "width": "pw",
              "padding-left": "5*@sf/@pf_outdated+4@sf/@pf+1@blockInterval",
              "flow": "vertical",
              "tdiv": {
                "size": "4@sf/@pf, ph-4*@sf/@pf_outdated",
                "pos": "5*@sf/@pf_outdated, 2*@sf/@pf_outdated",
                "position": "absolute",
                "background-color": "#ff9900"
              },
              "textareaNoTab": {
                "text": "#controls/help/submarine/depth_indicator_warn"
              }
            },
            {
              "width": "pw",
              "padding-left": "5*@sf/@pf_outdated+4@sf/@pf+1@blockInterval",
              "flow": "vertical",
              "tdiv": {
                "size": "4@sf/@pf, ph-4*@sf/@pf_outdated",
                "pos": "5*@sf/@pf_outdated, 2*@sf/@pf_outdated",
                "position": "absolute",
                "background-color": "#c91917"
              },
              "textareaNoTab": {
                "text": "#controls/help/submarine/depth_indicator_critical"
              }
            }
          ]
        },
        {
          "id": "depth_indicator_point",
          "pos": "1435/1760pw, 136/900ph",
          "position": "absolute",
          "size": "1@dp, 1@dp"
        },
        {
          "pos": "1744/1760pw-w, 16/900ph",
