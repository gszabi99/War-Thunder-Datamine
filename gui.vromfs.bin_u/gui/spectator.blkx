{
  "tdiv": [
    {
      "id": "spectator_root",
      "size": "sw - 2@bwHud, sh - 2@bhHud",
      "pos": "pw/2-w/2, ph/2-h/2",
      "position": "absolute",
      "spectatorFrame": [
        {
          "id": "map_div",
          "css-hier-invalidate": "yes",
          "position": "absolute",
          "top": "ph-h",
          "stickTo": "right",
          "min-height": "2@sIco",
          "padding": "1@framePadding",
          "tdiv": {
            "id": "content",
            "size": "1@spectatorTableWidth, 1@spectatorTableWidth",
            "tdiv": {
              "id": "map_div_bg",
              "size": "pw, ph",
              "tacticalMap": {
                "size": "pw, ph",
                "behaviour": "button",
                "on_click": "onMapClick"
              }
            }
          }
        },
        {
          "id": "map_large_div",
          "display": "hide",
          "width": "1@rh $min (1@rw -2@spectatorTableWidth -16@sf/@pf)",
          "height": "1@rh $min (1@rw -2@spectatorTableWidth -16@sf/@pf)",
          "pos": "pw/2-w/2, ph/2-h/2",
          "position": "absolute",
          "css-hier-invalidate": "yes",
          "padding": "1@framePadding",
          "behaviour": "button",
          "on_click": "onMapClick",
          "div": {
            "id": "tactical_map_large_bg",
            "size": "pw,ph",
            "tacticalMap": {
              "id": "tactical_map",
              "enable": "no",
              "size": "pw,ph",
              "behaviour": "button",
              "on_click": "onMapClick"
            }
          },
          "Button_close": {
            "id": "btnCloseMap",
            "on_click": "onMapClick",
            "pos": "pw-w-1@framePadding, 1@framePadding",
            "position": "absolute",
            "have_shortcut": "no"
          }
        }
      ],
      "hudActionBar": {
        "id": "spectator_hud_action_bar",
        "position": "absolute",
        "pos": "pw/2-w/2, ph-h",
        "height": "@hudActionBarItemSize",
        "actionBarNest": {
          "id": "actions_nest"
        }
      },
      "tdiv": [
        {
          "pos": "pw/2-w/2, ph-h - 0.06@shHud - 1@sIco",
          "position": "absolute",
          "flow": "vertical",
          "tdiv": {
            "id": "hud_hints_nest",
            "width": "2/3@rwHud",
            "flow": "vertical",
            "css-hier-invalidate": "yes",
            "behavior": "Timer",
            "tdiv": [
              {
                "id": "ship_obstacle_rf",
                "size": "pw, 0.04@shHud"
              },
              {
                "width": "pw",
                "position": "relative",
                "pos": "pw/2 - w/2, 0",
                "flow": "vertical",
                "tdiv": [
                  {
                    "id": "common_priority_hints_holder",
                    "position": "relative",
                    "tdiv": {
                      "id": "common_priority_hints",
                      "width": "pw",
                      "position": "relative",
                      "pos": "0, ph-h",
                      "flow": "vertical"
                    }
                  },
                  {
                    "width": "pw",
                    "tdiv": {
                      "id": "mission_hints",
                      "width": "pw",
                      "position": "relative",
                      "pos": "0, ph-h",
                      "flow": "vertical"
                    }
                  },
                  {
                    "id": "mission_action_hints_holder",
                    "position": "relative",
                    "tdiv": {
                      "id": "mission_action_hints",
                      "width": "pw",
                      "position": "relative",
                      "pos": "0, ph-h",
                      "flow": "vertical"
                    }
                  }
                ]
              },
              {
                "position": "relative",
                "left": "pw/2 - w/2",
                "div": [
                  {
                    "id": "iconed_hints"
                  },
                  {
                    "id": "display_timers"
                  }
                ]
              },
              {
                "id": "actionbar_hints_nest",
                "width": "1@shHud",
                "left": "0.5pw-0.5w",
                "position": "relative",
                "tdiv": {
                  "width": "pw",
                  "position": "relative",
                  "pos": "0, ph-h",
                  "flow": "vertical",
                  "tdiv": {
                    "id": "actionbar_hints",
                    "width": "pw",
                    "flow": "vertical"
                  }
                }
              },
              {
                "id": "tutorial_hints",
                "width": "pw",
                "position": "root",
                "pos": "50%sw-50%w, 1@bhHud + 0.67@shHud",
                "flow": "vertical"
              },
              {
                "id": "minor_priority_hints",
                "width": "pw",
                "position": "root",
                "pos": "50%sw-50%w, @shHud - h",
                "flow": "vertical"
              },
              {
                "id": "infantry_crosshair_hints_nest",
                "width": "0.3@rwHud",
                "left": "67%sw",
                "top": "78%sh",
                "position": "root",
                "display": "hide",
                "enable": "no",
                "hintSizeStyle": "crosshair",
                "tdiv": {
                  "id": "infantry_crosshair_hints",
                  "flow": "vertical",
                  "width": "pw"
                }
              }
            ],
            "hudMessages": {
              "id": "hud_message_zone_capture_notification",
              "width": "pw",
              "message_style": "zone_capture_notification",
              "input-transparent": "yes"
            },
            "textAreaCentered": {
              "id": "low-quality-model-warning",
              "width": "pw",
              "style": "color:@warningTextColor; font:@fontHudNormal;",
              "text": "#low_quality_model_in_hangar",
              "display": "hide"
            }
          },
          "activeText": {
            "id": "waiting_for_target_spawn",
            "pos": "pw/2-w/2, 0",
            "position": "relative",
            "padding-bottom": "12@sf/@pf",
            "text": "#spectator/waiting_for_target_spawn",
            "display": "hide"
          },
          "targetInfo": {
            "id": "target_info",
            "pos": "pw/2-w/2, 0",
            "position": "relative",
            "flow": "vertical",
            "display": "hide",
            "activeText": {
              "id": "target_state",
              "pos": "pw/2-w/2, 0",
              "position": "relative",
              "text": ""
            },
            "tdiv": {
              "id": "spectator_live_stats_nest",
              "pos": "pw/2-w/2, 0",
              "position": "relative",
              "display": "hide"
            }
          }
        },
        {
          "behaviour": "darg",
          "position": "root",
          "pos": "0, 0",
          "size": "sw, sh"
        }
      ],
      "toggleButton": {
        "id": "btnToggleMap",
        "on_click": "onToggleButtonClick",
        "attachSide": "right",
        "stickTo": "right",
        "toggled": "yes",
        "toggleObj": "map_div",
        "top": "ph-h - 1@spectatorTableWidth -16@sf/@pf",
        "position": "absolute",
        "icon": {}
      },
      "hitCamera": {
        "id": "hud_hitcamera",
        "position": "absolute",
        "pos": "pw - w, ph-h - 1@spectatorTableWidth -2@framePadding - @cIco - 2@blockInterval",
        "input-transparent": "yes",
        "total-input-transparent": "yes",
        "result": "",
        "_transp-timer": "0",
        "hitCameraRender": {
          "id": "hit_camera_render",
          "tdiv": [
            {
              "position": "absolute",
              "id": "indicators_nest"
            },
            {
              "size": "pw, ph",
              "position": "absolute",
              "overflow": "hidden",
              "hitCameraCritAnim": {
                "id": "critAnim",
                "height": "1@hitCameraHeight",
                "needAnim": "no",
                "_size-timer": "0",
                "_transp-timer": "0",
                "color-factor": "255"
              }
            }
          ],
          "hitCameraTitle": {
            "id": "title"
          },
          "enemyDamageStatusPanel": {
            "flow": "vertical",
            "tdiv": {
              "id": "damageStatus",
              "pos": "0.5pw-0.5w, 0",
              "position": "relative"
            }
          },
          "hitCameraInfo": {
            "id": "info",
            "margin-top": "0.5@hitcamDebuffPadding",
            "flow": "horizontal"
          }
        }
      },
      "timer": {
        "id": "update_timer",
        "timer_interval_msec": "300",
        "timer_handler_func": "onUpdate"
      }
    },
    {
      "id": "hud_message_timers"
    }
  ],
  "timer": {
    "id": "hud_message_timer"
  }
}