{
  "root": {
    "blur": {},
    "blur_foreground": {},
    "frame": {
      "size": "0.75sw, 1@maxWindowHeight",
      "max-width": "1@maxWindowWidth",
      "class": "wndNav",
      "flow": "vertical",
      "isCenteredUnderLogo": "yes",
      "frame_header": {
        "HorizontalListBox": {
          "id": "license_tabs",
          "height": "1@frameHeaderHeight",
          "position": "relative",
          "class": "header",
          "normalFont": "yes",
          "activeAccesskeys": "RS",
          "on_select": "onTabChange"
        },
        "Button_close": {}
      },
      "tdiv": {
        "id": "license_nest",
        "width": "pw",
        "height": "fh",
        "position": "relative",
        "overflow-y": "auto",
        "textarea": {
          "id": "license_text",
          "width": "pw",
          "padding": "0.01@sf",
          "text": ""
        }
      },
      "navBar": {
        "navMiddle": {
          "id": "paginator_place"
        }
      }
    }
  },
  "timer": {
    "id": "license_update",
    "timer_handler_func": "onUpdate",
    "timer_interval_msec": "250"
  }
}