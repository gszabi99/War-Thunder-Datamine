{
  "root": {
    "blur": {},
    "blur_foreground": {},
    "tdiv": {
      "position": "absolute",
      "pos": "50%pw-50%w, 50%ph-50%h",
      "width": "1@rw",
      "max-height": "1@rh",
      "tdiv": {
        "position": "absolute",
        "flow": "vertical",
        "top": "-h",
        "width": "pw",
        "tdiv": {
          "id": "usernick_place",
          "position": "relative",
          "halign": "center",
          "margin-bottom": "2.5@blockInterval"
        },
        "textareaNoTab": {
          "overlayTextColor": "active",
          "bigBoldFont": "yes",
          "halign": "center",
          "margin-bottom": "8@blockInterval",
          "font": "@fontBigBold",
          "text": "#mainmenu/firstUnit"
        },
        "textAreaCentered": {
          "overlayTextColor": "active",
          "max-width": "0.95pw",
          "halign": "center",
          "margin-bottom": "8@blockInterval",
          "text": "#mainmenu/firstUnitChoiceBonusNotice"
        }
      },
      "div": {
        "id": "first_choices_block",
        "width": "pw"
      },
      "textAreaCentered": {
        "id": "hint_text",
        "overlayTextColor": "active",
        "position": "absolute",
        "max-width": "0.85pw",
        "pos": "50%pw-50%w, ph + 8@blockInterval",
        "text": ""
      }
    }
  }
}