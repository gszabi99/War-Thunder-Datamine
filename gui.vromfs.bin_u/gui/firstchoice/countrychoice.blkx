{
  "root": {
    "blur": {},
    "tdiv": [
      {
        "position": "absolute",
        "pos": "1@bwInVr, 1@bhInVr",
        "size": "1@swOrRwInVr, 1@shOrRhInVr",
        "background-color": "#B30C1117",
        "input-transparent": "yes"
      },
      {
        "max-width": "1@rw",
        "max-height": "1@rh",
        "pos": "50%pw-50%w, 50%ph-50%h",
        "position": "absolute",
        "flow": "vertical",
        "css-hier-invalidate": "yes",
        "tdiv": [
          {
            "id": "usernick_place",
            "position": "relative",
            "left": "50%pw-50%w",
            "margin-bottom": "2.5@blockInterval"
          },
          {
            "id": "main_content",
            "flow": "horizontal",
            "css-hier-invalidate": "yes",
            "tdiv": [
              {
                "flow": "vertical",
                "valign": "center",
                "width": "1@firstChoiceCountriesColmns*(1@countryChoiceImageWidth + 1@countryChoiceInterval)",
                "css-hier-invalidate": "yes",
                "tdiv": [
                  {
                    "id": "countries",
                    "behaviour": "posNavigator",
                    "width": "pw",
                    "flow": "h-flow",
                    "flow-align": "center",
                    "navigatorShortcuts": "yes",
                    "total-input-transparent": "yes",
                    "css-hier-invalidate": "yes",
                    "on_select": "onClickCountry"
                  },
                  {
                    "size": "pw - 1@countryChoiceInterval, fh",
                    "min-height": "0.5@countryChoiceImageHeight",
                    "bgcolor": "#CC12161C",
                    "tdiv": {
                      "flow": "vertical",
                      "pos": "pw/2-w/2, ph/2-h/2",
                      "position": "absolute",
                      "textAreaCentered": [
                        {
                          "overlayTextColor": "active",
                          "position": "relative",
                          "left": "50%pw-50%w",
                          "margin-bottom": "1@blockInterval",
                          "text": "#mainmenu/firstCountryChoiceNoticePremium"
                        },
                        {
                          "id": "not_available_countries",
                          "overlayTextColor": "active",
                          "position": "relative",
                          "left": "50%pw-50%w",
                          "display": "hide"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "id": "country_info_div",
                "position": "relative",
                "width": "1@countryChoiceInfoWidth",
                "css-hier-invalidate": "yes",
                "background-color": "#CC12161C",
                "min-height": "ph",
                "textAreaCentered": {
                  "id": "choose_country_info",
                  "position": "absolute",
                  "overlayTextColor": "active",
                  "width": "0.75pw",
                  "halign": "center",
                  "valign": "center",
                  "text": "#mainmenu/choose_country"
                },
                "tdiv": {
                  "id": "country_info",
                  "position": "relative",
                  "width": "pw",
                  "min-height": "ph",
                  "flow": "vertical",
                  "display": "hide",
                  "padding": "@startingUnitSlotsInterval",
                  "textareaNoTab": {
                    "id": "country_info_title",
                    "margin-bottom": "@startingUnitSlotsInterval",
                    "overlayTextColor": "active",
                    "normalBoldFont": "yes"
                  },
                  "tdiv": [
                    {
                      "height": "fh",
                      "width": "pw",
                      "textareaNoTab": {
                        "id": "country_info_description",
                        "width": "pw",
                        "max-height": "ph",
                        "margin-bottom": "2@startingUnitSlotsInterval",
                        "overlayTextColor": "active",
                        "smallFont": "yes",
                        "overflow-y": "auto"
                      }
                    },
                    {
                      "id": "slots",
                      "flow": "vertical",
                      "position": "relative",
                      "width": "pw",
                      "textareaNoTab": [
                        {
                          "id": "starting_vehicles",
                          "margin-bottom": "@startingUnitSlotsInterval",
                          "smallFont": "yes"
                        },
                        {
                          "margin-bottom": "1@blockInterval",
                          "smallFont": "yes",
                          "text": "#firstChoiceCountry/late_unlock"
                        }
                      ],
                      "tdiv": [
                        {
                          "id": "starting_slots",
                          "margin-bottom": "@startingUnitSlotsInterval",
                          "tooltipLink": [
                            {
                              "id": "starting_unit1",
                              "margin-right": "@startingUnitSlotsInterval",
                              "isTooltipForChildren": "yes"
                            },
                            {
                              "id": "starting_unit2",
                              "isTooltipForChildren": "yes"
                            }
                          ]
                        },
                        {
                          "id": "late_unlock_slots",
                          "tooltipLink": [
                            {
                              "id": "lateUnlock_unit1",
                              "margin-right": "@startingUnitSlotsInterval",
                              "isTooltipForChildren": "yes"
                            },
                            {
                              "id": "lateUnlock_unit2",
                              "isTooltipForChildren": "yes"
                            }
                          ]
                        }
                      ],
                      "Button_text": {
                        "id": "btn_battle",
                        "position": "relative",
                        "margin-top": "20@sf/@pf",
                        "margin-bottom": "20@sf/@pf - 1@startingUnitSlotsInterval",
                        "left": "pw/2-w/2",
                        "class": "battle",
                        "navButtonFont": "yes",
                        "_on_click": "onToBattleClick",
                        "css-hier-invalidate": "yes",
                        "isCancel": "no",
                        "btnName": "X",
                        "pattern": {},
                        "buttonWink": {
                          "_transp-timer": "0"
                        },
                        "buttonGlance": {},
                        "ButtonImg": {},
                        "textarea": {
                          "class": "buttonText",
                          "text": "#mainmenu/toBattle"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        ],
        "textareaNoTab": {
          "overlayTextColor": "active",
          "bigBoldFont": "yes",
          "position": "relative",
          "left": "50%pw-50%w",
          "margin-bottom": "5@blockInterval",
          "font": "@fontBigBold",
          "text": "#mainmenu/firstCountry"
        }
      }
    ]
  }
}