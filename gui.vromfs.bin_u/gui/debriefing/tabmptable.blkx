{
  "debriefingTab": {
    "id": "players_stats_tab",
    "debrBlock": {
      "id": "players_stats_scroll_block",
      "size": "pw, ph",
      "position": "absolute",
      "padding": "0.5@debrPad",
      "overflow-y": "auto",
      "scrollbarShortcuts": "yes",
      "tdiv": {
        "size": "pw, ph",
        "tdiv": {
          "height": "ph",
          "pos": "pw/2-w/2, 0",
          "position": "relative",
          "statCell": [
            {
              "id": "team1-root",
              "size": "50%p.p.w, ph",
              "flow": "vertical",
              "tdiv": [
                {
                  "id": "team1_info",
                  "left": "pw-w-@tablePad",
                  "position": "relative",
                  "teamIco": "allies",
                  "css-hier-invalidate": "yes",
                  "activeText": {
                    "id": "team_text",
                    "padding-right": "0.01@scrn_tgt",
                    "top": "50%ph-50%h",
                    "position": "relative"
                  },
                  "teamImg": {
                    "id": "team_img",
                    "size": "0.04@scrn_tgt, 0.04@scrn_tgt",
                    "background-svg-size": "0.04@scrn_tgt, 0.04@scrn_tgt",
                    "pos": "0, 50%ph-50%h",
                    "position": "relative"
                  },
                  "tdiv": {
                    "id": "countries_block",
                    "pos": "0, ph/2-h/2",
                    "position": "relative"
                  },
                  "img": {
                    "id": "override_country",
                    "pos": "0, ph/2-h/2",
                    "position": "relative",
                    "size": "@cIco, 0.66@cIco",
                    "background-image": "",
                    "background-svg-size": "@cIco, 0.66@cIco",
                    "margin": "0.005@sf, 0"
                  }
                },
                {
                  "width": "pw",
                  "min-height": "0.037@scrn_tgt",
                  "margin-left": "1@scrollBarSize",
                  "margin-bottom": "0.0025@scrn_tgt",
                  "statCell": {
                    "id": "team_table_1",
                    "width": "pw",
                    "pos": "0, 50%ph-50%h",
                    "position": "absolute",
                    "display": "hide"
                  }
                }
              ],
              "statCell": {
                "size": "pw, fh",
                "overflow-y": "auto",
                "scroll-align": "left",
                "scroll-padding": "no",
                "padding-right": "-1@scrollBarSize",
                "statCell": {
                  "id": "table_kills_team1",
                  "position": "relative",
                  "width": "fw - 1@scrollBarSize - @tablePad",
                  "pos": "1@scrollBarSize, 1",
                  "flow": "vertical",
                  "interactive": "yes",
                  "behavior": "PosNavigator",
                  "navigatorShortcuts": "yes",
                  "canSelectNone": "yes",
                  "selfFocusBorder": "yes",
                  "on_select": "onStatsTblSelect",
                  "on_dbl_click": "onUserCard",
                  "on_r_click": "onUserRClick",
                  "on_hover": "onStatTblFocus",
                  "on_unhover": "onStatTblFocus"
                }
              }
            },
            {
              "id": "team2-root",
              "size": "50%p.p.w, ph",
              "flow": "vertical",
              "tdiv": [
                {
                  "id": "team2_info",
                  "left": "@tablePad",
                  "position": "relative",
                  "css-hier-invalidate": "yes",
                  "teamIco": "axis",
                  "teamImg": {
                    "id": "team_img",
                    "size": "0.04@scrn_tgt, 0.04@scrn_tgt",
                    "background-svg-size": "0.04@scrn_tgt, 0.04@scrn_tgt",
                    "pos": "0, 50%ph-50%h",
                    "position": "relative"
                  },
                  "img": {
                    "id": "override_country",
                    "pos": "0, ph/2-h/2",
                    "position": "relative",
                    "size": "@cIco, 0.66@cIco",
                    "background-image": "",
                    "background-svg-size": "@cIco, 0.66@cIco",
                    "margin": "0.005@sf, 0"
                  },
                  "tdiv": {
                    "id": "countries_block",
                    "pos": "0, ph/2-h/2",
                    "position": "relative"
                  },
                  "activeText": {
                    "id": "team_text",
                    "padding-left": "0.01@scrn_tgt",
                    "top": "50%ph-50%h",
                    "position": "relative"
                  }
                },
                {
                  "width": "pw",
                  "min-height": "0.037@scrn_tgt",
                  "margin-right": "1@scrollBarSize",
                  "margin-bottom": "0.0025@scrn_tgt",
                  "statCell": {
                    "id": "team_table_2",
                    "width": "pw",
                    "pos": "@tablePad, 50%ph-50%h",
                    "position": "absolute",
                    "display": "hide"
                  }
                }
              ],
              "statCell": {
                "size": "pw, fh",
                "overflow-y": "auto",
                "statCell": {
                  "id": "table_kills_team2",
                  "position": "relative",
                  "flow": "vertical",
                  "width": "fw - 1@scrollBarSize",
                  "pos": "@tablePad, 1",
                  "interactive": "yes",
                  "behavior": "PosNavigator",
                  "canSelectNone": "yes",
                  "navigatorShortcuts": "yes",
                  "selfFocusBorder": "yes",
                  "on_select": "onStatsTblSelect",
                  "on_dbl_click": "onUserCard",
                  "on_r_click": "onUserRClick",
                  "on_hover": "onStatTblFocus",
                  "on_unhover": "onStatTblFocus"
                }
              }
            }
          ]
        }
      }
    }
  }
}