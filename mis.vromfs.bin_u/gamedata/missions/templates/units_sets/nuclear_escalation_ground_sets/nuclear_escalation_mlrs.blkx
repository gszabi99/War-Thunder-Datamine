            "delay": 0.0,
            "offset": [
              0.0,
              0.0,
              0.0
            ],
            "object": "t1_mlrs_01",
            "target": "t1_mlrs_spawn_area_01",
            "randomSpawn": true
          },
          {
            "delay": 0.0,
            "offset": [
              0.0,
