    "spawn_mlrs_01": {
      "is_enabled": true,
      "comments": "MLRS are disabled in the 1970 era (mission rank <= 30): no historical MLRS existed in that time period. Each pair spawns only if the mission has its spawn areas",
      "props": {
        "actionsType": "PERFORM_ONE_BY_ONE",
        "conditionsType": "ALL",
        "enableAfterComplete": false
      },
      "events": {
        "initMission": {}
      },
      "conditions": {
        "varCompareInt": {
          "var_value": "mission_rank",
          "value": 30,
          "comparasion_func": "more"
        },
        "objectExists": [
          {
            "target": "t1_mlrs_spawn_area_01",
            "type": "area"
          },
          {
            "target": "t2_mlrs_spawn_area_01",
            "type": "area"
          }
        ]
      },
      "actions": {
        "unitRespawn": [
