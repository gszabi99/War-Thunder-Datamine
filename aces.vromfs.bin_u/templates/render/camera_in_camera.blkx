{
  "camera_in_camera": {
    "_singleton": true,
    "_use": "replicating",
    "_group": {
      "_tags": "render",
      "camcam__lens_render_active": false,
      "camcam__iFrame": -1,
      "camcam__frame_after_deactivation": false,
      "camcam__lens_only_zoom_enabled": false,
      "camcam__uv_remapping": [
        1.0,
        1.0,
        1.0,
        1.0
      ],
      "camcam__lens_viewport_uv": [
        0.0,
        0.0,
        1.0,
        1.0
      ]
    }
  }
}