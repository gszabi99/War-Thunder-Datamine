  "signals": {
    "GTM": {
      "groundClutter": false,
      "groundMultipath": false,
      "aircraftAsTarget": false,
      "groundVehiclesAsTarget": true,
      "angularAccuracy": 0.0,
      "distanceAccuracy": 1.0,
      "distance": {
        "presents": true,
        "minValue": 500.0,
        "maxValue": 370000.0,
        "width": 15.0
      }
    },
    "ATM": {
      "groundClutter": false,
      "groundMultipath": false,
      "aircraftAsTarget": true,
      "groundVehiclesAsTarget": false,
      "angularAccuracy": 0.0,
      "distanceAccuracy": 1.0,
      "distance": {
        "presents": true,
        "minValue": 500.0,
        "maxValue": 100000.0,
        "width": 15.0
      }
    },
    "MTI": {
      "groundClutter": false,
      "aircraftAsTarget": true,
      "groundVehiclesAsTarget": true,
      "angularAccuracy": 0.0,
      "distanceAccuracy": 1.0,
      "absDopplerSpeed": true,
      "mainBeamDopplerSpeed": true,
      "distance": {
        "presents": true,
        "minValue": 500.0,
        "maxValue": 370000.0,
        "width": 15.0
      },
      "dopplerSpeed": {
        "presents": true,
        "minValue": 10.0,
        "maxValue": 1000.0,
        "signalWidthMin": 5.0,
        "width": 0.0
      }
    }
  },
  "scanPatternSets": {
    "GTM": {
      "scanPattern1": "searchNarrowGTM",
      "scanPattern2": "searchWideGTM"
    },
    "MTI": {
      "scanPattern1": "searchNarrowMTI",
      "scanPattern2": "searchWideMTI"
    },
    "ATM": {
      "scanPattern1": "searchNarrowATM",
      "scanPattern2": "searchWideATM"
    }
  },
  "scopeRangeSets": {
    "search": {
      "range1": 18520.0,
      "range2": 37040.0,
      "range3": 74080.0,
      "range4": 148160.0,
      "range5": 370400.0
    },
    "ATM": {
      "range1": 18520.0,
      "range2": 37040.0
    }
  },
  "fsms": {
    "main": {
      "stateInit": "init",
      "actionsTemplates": {
        "init": {
          "setEnabled": {
            "value": false
          },
          "setCenterAzimuth": {
            "source": "constant",
            "value": 0.0
          },
          "setCenterElevation": [
            {
              "source": "constant",
              "value": 0.0
            },
            {
              "source": "constant",
              "value": -5.0
            }
          ],
          "setScopeRangeSet": {
            "scopeRangeSet": "search"
          },
          "setTransiver": {
            "transiver": "GTM"
          },
          "setSignal": {
            "signal": "GTM"
          },
          "setTargetDesignationRange": {
            "azimuthRange": [
              -90.0,
              90.0
            ],
            "azimuthRelWidthMin": 0.02,
            "elevationRange": [
              -60.0,
              15.0
            ],
            "distanceRange": [
              500.0,
              370400.0
            ]
          },
          "setFsmActive": {
            "fsm": "mode",
            "active": true
          }
        },
        "setStandbyMode": {
          "setModeName": {
            "name": "standby"
          },
          "setEnabled": {
            "value": false
          },
          "setFsmActive": {
            "fsm": "mode",
            "active": false
          }
        },
        "resetStandbyMode": {},
        "setSearchMode": {
          "setEnabled": {
            "value": true
          },
          "setFsmActive": [
            {
              "fsm": "tws",
              "active": true
            },
            {
              "fsm": "mode",
              "active": true
            }
          ],
          "setCueEnabled": {
            "value": true,
            "updateActiveTargetUnderCue": true
          }
        },
        "resetSearchMode": {
          "clearTargets": {},
          "setFsmActive": {
            "fsm": "tws",
            "active": false
          },
          "setCueEnabled": {
            "value": false
          }
        }
      },
      "transitions": {
        "init": {
          "stateFrom": "init",
          "event": "init",
          "stateTo": "standby",
          "actions": {
            "init": {},
            "setStandbyMode": {}
          }
        },
        "switchOn": {
          "stateFrom": "standby",
          "command": "switch",
          "event": "enable",
          "stateTo": "search",
          "actions": {
            "setSearchMode": {}
          }
        },
        "switchOff": {
          "stateFrom": "search",
          "command": "switch",
          "event": "disable",
          "stateTo": "standby",
          "actions": {
            "resetSearchMode": {},
            "setStandbyMode": {}
          }
        },
        "switchScanPattern": {
          "stateFrom": [
            "standby",
            "search"
          ],
          "command": "scanPatternSwitch",
          "actions": {
            "setNextScanPattern": {}
          }
        },
        "switchScopeRange": {
          "command": "rangeSwitch",
          "actions": {
            "setNextScopeRange": {}
          }
        }
      }
    },
    "tws": {
      "stateInit": "search",
      "transitions": {
        "scan": {
          "event": "update",
          "actions": {
            "scan": {},
            "extrapolateTargetsOfInterest": {},
            "clearTargetsOfInterest": {
              "timeOut": 8.0
            },
            "setCueToActiveTargetOfInterest": {
              "elevation": false
            },
            "setCenterAzimuth": [
              {
                "source": "constant",
                "value": 0.0
              },
              {
                "source": "designationCue"
              }
            ],
            "setCenterElevation": [
              {
                "source": "constant",
                "value": 0.0
              },
              {
                "source": "designationCue"
              }
            ]
          }
        },
        "detect": {
          "event": "targetInSight",
          "actions": {
            "setDistGatePos": {
              "source": "continuousScale",
              "width": 0.0
            },
            "setRelSpeedGatePos": {
              "source": "continuousScale",
              "width": 0.0
            },
            "detectTarget": {}
          }
        },
        "addTarget": {
          "event": "targetDetected",
          "actions": {
            "addTargetOfInterestCandidate": {},
            "updateActiveDetectedTarget": {},
            "setCueToActiveTargetOfInterest": {
              "elevation": false
            }
          }
        },
        "matchTargets": {
          "event": "scanFinished",
          "actions": {
            "matchTargetsOfInterest": {
              "limit": 100,
              "timeMin": 2.0,
              "posGateTimeInitial": [
                2.0,
                4.0
              ],
              "posGateRangeInitial": 1500.0,
              "posGateMaxTime": 2.0,
              "posGateRange": [
                0.0,
                300.0
              ],
              "dopplerSpeedGateMaxTime": 2.0,
              "dopplerSpeedGateRange": [
                0.0,
                400.0
              ]
            }
          }
        },
        "switchSelectedTarget": {
          "command": "switchTarget",
          "actions": {
            "setNextDetectedTargetActive": {}
          }
        },
        "setCueAzimuth": {
          "command": "cueAxisX",
          "actions": {
            "setCueAzimuth": {}
          }
        },
        "setCueDist": {
          "command": "cueAxisY",
          "actions": {
            "setCueDist": {}
          }
        },
        "setCueElevation": {
          "command": "cueAxisZ",
          "actions": {
            "setCueElevation": {}
          }
        },
        "setSelectedTarget": {
          "command": "switchToTarget",
          "actions": {
            "setDetectedTargetActive": {}
          }
        },
        "centerZone": {
          "command": "directionAxesReset",
          "actions": {
            "setCueToBoresight": {},
            "setCenterAzimuth": {
              "source": "designationCue"
            },
            "setCenterElevation": {
              "source": "designationCue"
            },
            "updateActiveDetectedTarget": {}
          }
        }
      }
    },
    "mode": {
      "stateInit": "init",
      "actionsTemplates": {
        "setGTMMode": {
          "setModeName": {
            "name": "ground_search"
          },
          "setTransiver": {
            "transiver": "GTM"
          },
          "setSignal": {
            "signal": "GTM"
          },
          "setScanPatternSet": {
            "scanPatternSet": "GTM"
          },
          "setCenterElevation": {
            "source": "constant",
            "value": -5.0
          },
          "setScopeRangeSet": {
            "scopeRangeSet": "search"
          },
          "clearTargets": {}
        },
        "setATMMode": {
          "setModeName": {
            "name": "air_search"
          },
          "setTransiver": {
            "transiver": "ATM"
          },
          "setSignal": {
            "signal": "ATM"
          },
          "setScanPatternSet": {
            "scanPatternSet": "ATM"
          },
          "setCenterElevation": {
            "source": "constant",
            "value": -5.0
          },
          "setScopeRangeSet": {
            "scopeRangeSet": "ATM"
          },
          "clearTargets": {}
        },
        "setMTIMode": {
          "setModeName": {
            "name": "MTI search"
          },
          "setTransiver": {
            "transiver": "MTI"
          },
          "setSignal": {
            "signal": "MTI"
          },
          "setScanPatternSet": {
            "scanPatternSet": "MTI"
          },
          "setCenterElevation": {
            "source": "constant",
            "value": -5.0
          },
          "setScopeRangeSet": {
            "scopeRangeSet": "search"
          },
          "clearTargets": {}
        }
      },
      "transitions": {
        "init": {
          "stateFrom": "init",
          "event": "fsmActivate",
          "stateTo": "mti",
          "actions": {
            "setGTMMode": {}
          }
        },
        "showGTM": {
          "stateFrom": "gtm",
          "event": "fsmActivate",
          "stateTo": "gtm",
          "actions": {
            "setGTMMode": {}
          }
        },
        "showATM": {
          "stateFrom": "atm",
          "event": "fsmActivate",
          "stateTo": "atm",
          "actions": {
            "setATMMode": {}
          }
        },
        "showMTI": {
          "stateFrom": "mti",
          "event": "fsmActivate",
          "stateTo": "mti",
          "actions": {
            "setMTIMode": {}
          }
        },
        "switchToATM": {
          "stateFrom": "mti",
          "command": "modeSwitch",
          "stateTo": "atm",
          "actions": {
            "setATMMode": {}
          }
        },
        "switchToGTM": {
          "stateFrom": "atm",
          "command": "modeSwitch",
          "stateTo": "gtm",
          "actions": {
            "setGTMMode": {}
          }
        },
        "switchToMTI": {
          "stateFrom": "gtm",
          "command": "modeSwitch",
          "stateTo": "mti",
          "actions": {
            "setMTIMode": {}
          }
        }
      }
    }
  }
}