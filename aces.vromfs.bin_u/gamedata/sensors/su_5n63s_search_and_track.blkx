              "set": false
            }
          }
        },
        "deactivateStandby": {
          "stateFrom": "standby",
          "event": "fsmDeactivate",
          "stateTo": "standbyInactive"
        },
        "activateSearch": {
          "stateFrom": "searchInactive",
          "event": "fsmActivate",
          "stateTo": "search",
          "actions": {
            "setSearchMode": {},
            "setDesignatedTarget": {
              "aiOnly": true,
              "set": false
            }
          }
        },
        "deactivateSearch": {
          "stateFrom": "search",
          "event": "fsmDeactivate",
          "stateTo": "searchInactive",
          "actions": {
            "resetSearchMode": {}
          }
        }
      }
