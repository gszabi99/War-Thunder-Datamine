          "actions": {
            "detectTarget": {
              "ignoreOwnWeapon": true,
              "rangeMult": 1.0
            }
          }
        }
      }
    },
    "track": {
      "stateInit": "track",
      "transitions": {
        "scan": {
          "event": "update",
          "stateFrom": "track",
          "stateTo": "search",
          "actions": {
            "scan": {
              "ignoreOwnWeapon": true
            },
            "extrapolateTargetsOfInterest": {},
            "clearTargetsOfInterest": {
              "timeOut": 2.0
            },
            "setCueToActiveTargetOfInterest": {},
            "update": {}
          }
        },
        "scanTrack": {
          "stateFrom": "search",
          "event": "update",
          "stateTo": "track",
          "actions": {
            "scan": {
              "ignoreOwnWeapon": true,
              "scanPattern": "fastTws"
            },
