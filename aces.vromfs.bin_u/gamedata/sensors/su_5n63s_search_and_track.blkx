          }
        },
        "switchToStandby": {
          "stateFrom": "search",
          "command": "switch",
          "event": "disable",
          "stateTo": "standby",
          "actions": {
            "resetSearchMode": {},
            "setStandbyMode": {}
          }
        },
        "activateStandby": {
          "stateFrom": "standbyInactive",
          "event": "fsmActivate",
          "stateTo": "standby",
          "actions": {
            "resetSearchMode": {},
            "setStandbyMode": {},
            "setDesignatedTarget": {
