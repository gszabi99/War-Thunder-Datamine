              "width": 0.0
            },
            "detectTarget": {
              "ignoreOwnWeapon": true
            }
          }
        },
        "addTarget": {
          "stateFrom": "search",
          "event": "targetDetected",
          "actions": {
            "updateTargetOfInterest": {
              "limit": 30,
              "posGateTimeInitial": [
                2.0,
                4.0
              ],
              "posGateRangeInitial": 1500.0,
              "posGateMaxTime": 2.0,
              "posGateRange": [
                50.0,
                2000.0
              ],
              "dopplerSpeedGateMaxTime": 2.0,
              "dopplerSpeedGateRange": [
                0.0,
                400.0
              ]
            },
            "updateActiveDetectedTarget": [
              {},
              {}
            ],
            "setCueToActiveTargetOfInterest": [
              {},
              {}
            ]
          }
        },
        "addTargetTrack": {
          "stateFrom": "track",
          "event": "targetDetected",
          "actions": {
            "updateTargetOfInterest": {
              "limit": 30,
              "onlyExisting": true,
              "posGateTimeInitial": [
                2.0,
                4.0
              ],
              "posGateRangeInitial": 1500.0,
              "posGateMaxTime": 2.0,
              "posGateRange": [
                0.0,
                1000.0
              ],
              "dopplerSpeedGateMaxTime": 2.0,
              "dopplerSpeedGateRange": [
                0.0,
                400.0
              ]
            },
            "updateActiveDetectedTarget": {},
            "setCueToActiveTargetOfInterest": {},
            "setCenterAzimuth": {
              "source": "activeTargetOfInterest"
            },
            "setDistGatePos": {
              "source": "activeTargetOfInterest",
              "width": 0.0
            }
          }
        },
        "switchSelectedTarget": {
          "command": "switchTarget",
          "actions": {
            "setNextDetectedTargetActive": {}
          }
        },
        "setCueAzimuth": {
          "command": "cueAxisX",
          "actions": {
            "setCueAzimuth": {}
          }
        },
        "setCueDist": {
          "command": "cueAxisY",
          "actions": {
            "setCueDist": {}
          }
        },
        "setCueElevation": {
          "command": "cueAxisZ",
          "actions": {
            "setCueElevation": {}
          }
        },
        "setSelectedTarget": {
          "command": "switchToTarget",
          "actions": {
            "setDetectedTargetActive": {}
          }
        }
      }
    },
    "illumination": {
      "stateInit": "init",
      "transitions": {
        "activate": {
          "event": "fsmActivate",
          "stateTo": "active",
          "actions": {
            "checkIlluminationTimeOut": {
              "transiver": true,
              "pauseMax": 20.0
            }
          }
        },
        "deactivate": {
          "event": "fsmDeactivate",
          "stateTo": "inactive",
          "actions": {
            "setIllumination": {
              "transiver": false
            }
          }
        },
        "activateIllumination": {
          "event": "sarhMissileLaunch",
          "actions": {
            "setIlluminationTimeOut": {
              "timeOut": 120.0
            }
          }
        },
        "updateIllumination": {
          "event": "update",
          "actions": {
            "checkIlluminationTimeOut": {
              "transiver": true,
              "pauseMax": 20.0
            }
          }
        }
      }
    }
  }
