{
  "type": "radar",
  "name": "9S35",
  "transivers": {
    "common": {
      "power": 450.0,
      "band": 8,
      "rcs": 4.0,
      "range": 60000.0,
      "rangeMax": 60000.0,
      "antenna": {
        "azimuth": {
          "angleHalfSens": 1.5,
          "sideLobesSensitivity": -32.0
        },
        "elevation": {
          "angleHalfSens": 6.0,
          "sideLobesSensitivity": -32.0
        }
      }
    }
  },
  "illuminationTransmitter": {
    "power": 450.0,
    "antenna": {
      "angleHalfSens": 2.0,
      "sideLobesSensitivity": -35.0
    }
  },
  "scanPatterns": {
    "search": {
      "type": "pyramide",
      "azimuthLimits": [
        -180.0,
        180.0
      ],
      "elevationLimits": [
        -10.0,
        12.0
      ],
      "yawStabLimit": 180.0,
      "pitchStabLimit": 10.0,
      "rollStabLimit": 10.0,
      "period": 4.0,
      "width": 60.0,
      "barHeight": 6.0,
      "barsCount": 2,
      "rowMajor": true,
      "barsOneWay": true
    },
    "lock": {
      "type": "pyramide",
      "azimuthLimits": [
        -180.0,
        180.0
      ],
      "elevationLimits": [
        -10.7,
        89.6
      ],
      "yawStabLimit": 180.0,
      "pitchStabLimit": 89.6,
      "rollStabLimit": 10.0,
      "period": 1.0,
      "width": 22.5,
      "barHeight": 3.0,
      "barsCount": 2,
      "rowMajor": false,
      "indicate": true
    },
    "losLock": {
      "type": "pyramide",
      "azimuthLimits": [
        -180.0,
        180.0
      ],
      "elevationLimits": [
        -10.7,
        89.6
      ],
      "yawStabLimit": 180.0,
      "pitchStabLimit": 89.6,
      "rollStabLimit": 10.0,
      "period": 0.25,
      "width": 1.5,
      "barHeight": 3.0,
      "barsCount": 1,
      "rowMajor": false,
      "indicate": true
    },
    "track": {
      "type": "no",
      "azimuthLimits": [
        -180.0,
        180.0
      ],
      "elevationLimits": [
        -10.7,
        89.6
      ],
      "yawStabLimit": 180.0,
      "pitchStabLimit": 89.6,
      "rollStabLimit": 10.0
    }
  },
  "scanPatternSets": {
    "search": {
      "scanPattern2": "search"
    }
  },
  "scopeRangeSets": {
    "common": {
      "range1": 60000.0
    }
  },
  "signals": {
    "search": {
      "groundClutter": false,
      "absDopplerSpeed": true,
      "distance": {
        "presents": true,
        "minValue": 75.0,
        "maxValue": 60000.0
      },
      "dopplerSpeed": {
        "presents": true,
        "minValue": 15.0,
        "maxValue": 1000.0,
        "signalWidthMin": 5.0,
        "width": 0.0
      }
    },
    "track": {
      "groundClutter": false,
      "absDopplerSpeed": true,
      "track": true,
      "distance": {
        "presents": true,
        "minValue": 75.0,
        "maxValue": 60000.0
      },
      "dopplerSpeed": {
        "presents": true,
        "minValue": 15.0,
        "maxValue": 1000.0,
        "signalWidthMin": 5.0,
        "width": 0.0
      }
    }
  },
  "fsms": {
    "main": {
      "stateInit": "init",
      "actionsTemplates": {
        "init": {
          "setEnabled": {
            "value": false
          },
          "setTransiver": {
            "transiver": "common"
          },
          "setSignal": {
            "signal": "search"
          },
          "setTargetDesignationRange": {
            "azimuthRange": [
              -180.0,
              180.0
            ],
            "azimuthWidth": 5.0,
            "distanceRange": [
              0.0,
              60000.0
            ]
          },
          "setScopeRangeSet": {
            "scopeRangeSet": "common"
          }
        },
        "setLockMode": {
          "setModeName": {
            "name": "acquisition"
          },
          "setEnabled": {
            "value": true
          },
          "setDesignatedTarget": {
            "set": true
          },
          "clearTargetsOfInterest": {},
          "setScanPatternSet": {},
          "setCenterAzimuth": [
            {
              "source": "targetDesignation"
            },
            {
              "source": "targetDesignation"
            }
          ],
          "setScanPattern": {
            "scanPattern": "lock"
          },
          "resetScanPhase": {},
          "setFsmActive": {
            "fsm": "lock",
            "active": true
          },
          "setSignal": {
            "signal": "track"
          },
          "setCenterElevation": {
            "source": "constant",
            "value": 6.0
          },
          "setDistGatePos": {
            "source": "targetDesignation",
            "width": 1000.0
          }
        },
        "setLosVisualPreLockMode": {
          "setEnabled": {
            "value": true
          },
          "setScanPatternSet": {},
          "setScanPattern": {
            "scanPattern": "losLock"
          },
          "resetScanPhase": {},
          "setCenterAzimuth": {
            "source": "targetDesignation"
          },
          "setCenterElevation": {
            "source": "targetDesignation"
          },
          "clearTargetsOfInterest": {},
          "setFsmActive": {
            "fsm": "lock",
            "active": true
          }
        },
        "setLosLockMode": {
          "setModeName": {
            "name": "acquisition"
          },
          "setEnabled": [
            {
              "value": true
            },
            {
              "value": true
            }
          ],
          "setWeaponDetectionAllowance": {
            "source": "targetDesignation"
          },
          "setDesignatedTarget": {
            "set": false
          },
          "setSignal": {
            "signal": "track"
          },
          "setDistGatePos": {
            "source": "constRange",
            "pos": 30000.0,
            "width": 60000.0
          }
        },
        "setVisualLockMode": {
          "setModeName": {
            "name": "acquisition"
          },
          "setEnabled": {
            "value": true
          },
          "setWeaponDetectionAllowance": {
            "source": "const",
            "value": true
          },
          "setDesignatedTarget": {
            "set": true
          },
          "setSignal": {
            "signal": "track"
          },
          "setDistGatePos": {
            "source": "targetDesignation",
            "width": 1000.0
          }
        },
        "setTrackMode": {
          "setModeName": {
            "name": "track"
          },
          "setEnabled": [
            {
              "value": true
            },
            {
              "value": true
            }
          ],
          "setWeaponDetectionAllowance": {
            "source": "const",
            "value": true
          },
          "setDesignatedTarget": {
            "set": false
          },
          "setScanPatternSet": {},
          "setScanPattern": {
            "scanPattern": "track"
          },
          "clearTargetsOfInterest": {},
          "addTargetOfInterest": {},
          "setLastTargetOfInterestActive": {},
          "updateActiveTargetOfInterest": {},
          "setCenterAzimuth": {
            "source": "activeTargetOfInterest"
          },
          "setCenterElevation": {
            "source": "activeTargetOfInterest"
          },
          "setDistGatePos": {
            "source": "activeTargetOfInterest",
            "width": 0.0
          },
          "setFsmActive": [
            {
              "fsm": "track",
              "active": true
            },
            {
              "fsm": "illumination",
              "active": true
            }
          ],
          "setSignal": {
            "signal": "track"
          }
        }
      },
      "transitions": {
        "init": {
          "stateFrom": "init",
          "event": "init",
          "stateTo": "standbyOrSearch",
          "actions": {
            "init": {},
            "setFsmActive": {
              "fsm": "standbyOrSearch",
              "active": true
            }
          }
        },
        "selectTarget": {
          "stateFrom": "standbyOrSearch",
          "command": "selectTarget",
          "actions": {
            "updateActiveDetectedTarget": {},
            "designateTargetUnderCue": {
              "type": "cue",
              "self": true,
              "sensorIndex": 0
            },
            "designateActiveDetectedTarget": {
              "type": "target",
              "self": true,
              "sensorIndex": 0
            },
            "setDesignatedTarget": {
              "aiOnly": true,
              "set": true
            }
          }
        },
        "checkLockType0": {
          "stateFrom": "standbyOrSearch",
          "command": "designateTarget",
          "stateTo": "checkLockType0",
          "actions": {
            "checkDesignationTypeEquals": {
              "type": [
                "target",
                "cue"
              ]
            }
          }
        },
        "lock": {
          "stateFrom": "checkLockType0",
          "event": "designationTypeEquals",
          "stateTo": "lock",
          "actions": {
            "setFsmActive": {
              "fsm": "standbyOrSearch",
              "active": false
            },
            "setLockMode": {}
          }
        },
        "checkLockTypeLos": {
          "stateFrom": "checkLockType0",
          "event": "designationTypeNotEquals",
          "stateTo": "checkLockTypeLos",
          "actions": {
            "checkDesignationTypeEquals": {
              "type": "los"
            }
          }
        },
        "losLock": {
          "stateFrom": "checkLockTypeLos",
          "event": "designationTypeEquals",
          "stateTo": "losLock",
          "actions": {
            "setFsmActive": {
              "fsm": "standbyOrSearch",
              "active": false
            },
            "setLosVisualPreLockMode": {},
            "setLosLockMode": {}
          }
        },
        "checkLockTypeVisual": {
          "stateFrom": "checkLockTypeLos",
          "event": "designationTypeNotEquals",
          "stateTo": "checkLockTypeVisual",
          "actions": {
            "checkDesignationTypeEquals": {
              "type": "visual"
            }
          }
        },
        "visualLock": {
          "stateFrom": "checkLockTypeVisual",
          "event": "designationTypeEquals",
          "stateTo": "visualLock",
          "actions": {
            "setFsmActive": {
              "fsm": "standbyOrSearch",
              "active": false
            },
            "setLosVisualPreLockMode": {},
            "setVisualLockMode": {}
          }
        },
        "finishLockTypeCheck": {
          "stateFrom": "checkLockTypeVisual",
          "event": "designationTypeNotEquals",
          "stateTo": "standbyOrSearch"
        },
        "track": {
          "stateFrom": [
            "lock",
            "losLock",
            "visualLock"
          ],
          "event": "targetDetected",
          "stateTo": "track",
          "actions": {
            "setFsmActive": [
              {
                "fsm": "lock",
                "active": false
              },
              {
                "fsm": "lock",
                "active": false
              }
            ],
            "setTrackMode": {}
          }
        },
        "failedLock": {
          "stateFrom": [
            "lock",
            "losLock",
            "visualLock"
          ],
          "event": "scanFinished",
          "stateTo": "standbyOrSearch",
          "actions": {
            "setFsmActive": [
              {
                "fsm": "lock",
                "active": false
              },
              {
                "fsm": "standbyOrSearch",
                "active": true
              }
            ]
          }
        },
        "finishedTrack": {
          "stateFrom": "track",
          "event": "targetsOfInterestCleanup",
          "command": [
            "selectTarget",
            "designateTarget"
          ],
          "stateTo": "standbyOrSearch",
          "actions": {
            "setFsmActive": [
              {
                "fsm": "track",
                "active": false
              },
              {
                "fsm": "standbyOrSearch",
                "active": true
              },
              {
                "fsm": "illumination",
                "active": false
              }
            ]
          }
        },
        "switchScanPattern": {
          "stateFrom": "standbyOrSearch",
          "command": "scanPatternSwitch",
          "actions": {
            "setNextScanPattern": {}
          }
        },
        "switchScopeRange": {
          "command": "rangeSwitch",
          "actions": {
            "setNextScopeRange": {}
          }
        }
      }
    },
    "search": {
      "stateInit": "search",
      "transitions": {
        "scan": {
          "event": "update",
          "actions": {
            "setCenterAzimuth": {
              "source": "body"
            },
            "scan": {}
          }
        },
        "detect": {
          "event": "targetInSight",
          "actions": {
            "setDistGatePos": {
              "source": "continuousScale",
              "width": 0.0
            },
            "setRelSpeedGatePos": {
              "source": "continuousScale",
              "width": 0.0
            },
            "detectTarget": {}
          }
        },
        "addTarget": {
          "event": "targetDetected",
          "actions": {
            "addTarget": {},
            "updateActiveDetectedTarget": {}
          }
        },
        "switchSelectedTarget": {
          "command": "switchTarget",
          "actions": {
            "setNextDetectedTargetActive": {}
          }
        },
        "setCueAzimuth": {
          "command": "cueAxisX",
          "actions": {
            "setCueAzimuth": {}
          }
        },
        "setCueDist": {
          "command": "cueAxisY",
          "actions": {
            "setCueDist": {}
          }
        },
        "setCueElevation": {
          "command": "cueAxisZ",
          "actions": {
            "setCueElevation": {}
          }
        },
        "setSelectedTarget": {
          "command": "switchToTarget",
          "actions": {
            "setDetectedTargetActive": {}
          }
        }
      }
    },
    "standbyOrSearch": {
      "stateInit": "init",
      "actionsTemplates": {
        "setStandbyMode": {
          "setModeName": {
            "name": "standby"
          },
          "setEnabled": {
            "value": false
          },
          "clearTargetsOfInterest": {},
          "setScanPattern": {
            "scanPattern": "search"
          },
          "setCenterElevation": {
            "source": "constant",
            "value": 6.0
          }
        },
        "setSearchMode": {
          "setModeName": {
            "name": "search"
          },
          "setEnabled": {
            "value": true
          },
          "setWeaponDetectionAllowance": {
            "source": "const",
            "value": true
          },
          "setDesignatedTarget": {
            "set": false
          },
          "setCenterAzimuth": {
            "source": "constant",
            "value": 0.0
          },
          "setFsmActive": {
            "fsm": "search",
            "active": true
          },
          "clearTargetsOfInterest": {},
          "setCueEnabled": {
            "value": true
          },
          "setTransiver": {
            "transiver": "common"
          },
          "setSignal": {
            "signal": "search"
          },
          "setScanPattern": {
            "scanPattern": "search"
          },
          "setCenterElevation": {
            "source": "constant",
            "value": 6.0
          }
        },
        "resetSearchMode": {
          "clearTargets": {},
          "setFsmActive": {
            "fsm": "search",
            "active": false
          },
          "setCueEnabled": {
            "value": false
          }
        }
      },
      "transitions": {
        "init": {
          "stateFrom": "init",
          "event": "init",
          "stateTo": "standby",
          "actions": {
            "setStandbyMode": {}
          }
        },
        "switchToSearch": {
          "stateFrom": "standby",
          "command": "switch",
          "event": "enable",
          "stateTo": "search",
          "actions": {
            "setSearchMode": {}
          }
        },
        "switchToStandby": {
          "stateFrom": "search",
          "command": "switch",
          "event": "disable",
          "stateTo": "standby",
          "actions": {
            "resetSearchMode": {},
            "setStandbyMode": {}
          }
        },
        "activateStandby": {
          "stateFrom": "standbyInactive",
          "event": "fsmActivate",
          "stateTo": "standby",
          "actions": {
            "resetSearchMode": {},
            "setStandbyMode": {},
            "setDesignatedTarget": {
              "aiOnly": true,
              "set": false
            }
          }
        },
        "deactivateStandby": {
          "stateFrom": "standby",
          "event": "fsmDeactivate",
          "stateTo": "standbyInactive"
        },
        "activateSearch": {
          "stateFrom": "searchInactive",
          "event": "fsmActivate",
          "stateTo": "search",
          "actions": {
            "setSearchMode": {},
            "setDesignatedTarget": {
              "aiOnly": true,
              "set": false
            }
          }
        },
        "deactivateSearch": {
          "stateFrom": "search",
          "event": "fsmDeactivate",
          "stateTo": "searchInactive",
          "actions": {
            "resetSearchMode": {}
          }
        }
      }
    },
    "lock": {
      "stateInit": "lock",
      "transitions": {
        "scan": {
          "event": "update",
          "actions": {
            "scan": {},
            "setCenterAzimuth": {
              "source": "targetDesignation"
            }
          }
        },
        "detect": {
          "event": "targetInSight",
          "actions": {
            "detectTarget": {
              "ignoreOwnWeapon": true,
              "rangeMult": 1.0
            }
          }
        }
      }
    },
    "track": {
      "stateInit": "track",
      "transitions": {
        "detect": {
          "event": "update",
          "actions": {
            "detectTarget": {
              "ignoreOwnWeapon": true,
              "rangeMult": 1.0
            }
          }
        },
        "track": {
          "event": "targetDetected",
          "actions": {
            "updateActiveTargetOfInterest": {
              "dirFilter": {
                "alpha": 0.8,
                "betta": 0.1,
                "rateLim": [
                  0.78,
                  0.78
                ],
                "rateLimTimeOut": 0.1,
                "inertialTimeMax": 1.0
              },
              "distFilter": {
                "alpha": 0.8,
                "betta": 0.2,
                "accelLim": [
                  150.0,
                  150.0
                ],
                "accelLimTimeOut": 1.0,
                "rateLim": [
                  1500.0,
                  1500.0
                ],
                "rateLimTimeOut": 0.1,
                "inertialTimeMax": 1.0
              }
            },
            "setCenterAzimuth": {
              "source": "activeTargetOfInterest"
            },
            "setCenterElevation": {
              "source": "activeTargetOfInterest"
            },
            "setDistGatePos": {
              "source": "activeTargetOfInterest",
              "width": 0.0
            }
          }
        },
        "extrapolate": {
          "event": "targetNotDetected",
          "actions": {
            "extrapolateTargetsOfInterest": {},
            "clearTargetsOfInterest": {
              "timeOut": 3.0,
              "dirRateLim": 1.0
            },
            "setCenterAzimuth": {
              "source": "activeTargetOfInterest"
            },
            "setCenterElevation": {
              "source": "activeTargetOfInterest"
            },
            "setDistGatePos": {
              "source": "activeTargetOfInterest",
              "width": 0.0
            }
          }
        }
      }
    },
    "illumination": {
      "stateInit": "init",
      "transitions": {
        "activate": {
          "event": "fsmActivate",
          "stateTo": "active",
          "actions": {
            "checkIlluminationTimeOut": {
              "transiver": true,
              "pauseMax": 80.0
            }
          }
        },
        "deactivate": {
          "event": "fsmDeactivate",
          "stateTo": "inactive",
          "actions": {
            "setIllumination": {
              "transiver": false
            }
          }
        },
        "activateIllumination": {
          "event": "sarhMissileLaunch",
          "actions": {
            "setIlluminationTimeOut": {
              "timeOut": 120.0
            }
          }
        },
        "updateIllumination": {
          "event": "update",
          "actions": {
            "checkIlluminationTimeOut": {
              "transiver": true,
              "pauseMax": 80.0
            }
          }
        }
      }
    }
  }
}